# Copy to .env for local use. Never commit real credentials.
CRRO_DATABASE_URL=sqlite:///./crro_demo.db        # or postgresql://user:pass@host:5432/crro
CRRO_PROVIDER=simulator                           # simulator | razorpay_test (rzp_test_ keys only)
CRRO_DEMO_MODE=1                                  # simulator only: enables documented local-demo tokens
# CRRO_OPERATOR_TOKENS=<token>=16+chars>:<merchant_id>:<actor>[:operator|viewer],...
CRRO_SIMULATOR_WEBHOOK_SECRET=change-me-local-only
CRRO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
CRRO_MODEL_DIR=outputs/model
CRRO_ENABLE_SIMULATOR_ENDPOINTS=1
# Razorpay Test Mode (optional; not required for the demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
